pragma language_version >= 0.17.0;
import CompactStandardLibrary;

export ledger eventDescription: Opaque<"String">;
export ledger eventName: Opaque<"String">;
export ledger eventCapacity: Uint<32>;
export ledger eventOwner: Bytes<32>;
export ledger ticketPrice: Uint<32>;

witness secretKey(): Bytes<32>;
witness findItem(item: Field): MerkleTreePath<10, Field>;


constructor(
    eventCapacity_: Uint<32>,
    ticketPrice_: Field,
) {
    eventCapacity = disclose(eventCapacity_);
    ticketPrice = ticketPrice_;
    eventOwner = publicKey(disclose(secretKey()));
}

export circuit buyTicket(
    id: Bytes<30>, name: Bytes<30>, age: Field, email: Bytes<30>
): Boolean {
    assert capacity > 0
    assert(eventCapacity > 0, "There are no more tickets left.");
    capacity = capacity-1;
    eventCapacity = eventCapacity - 1;

    assert list length is == amountOfDataRequired
    assert(fieldData.length() == amountOfDataRequired, "Wrong amount of data provided.");

    Pay the ticket price to the owner
    builtin.send(ticketPrice, eventOwner);

    Construct the Merkle root and return it
    const tree = new MerkleTree<2, Field>();
    
    return true;
}


export circuit check(credential: MerkleTree<4, Field>, item: Field): [] {
  // Verify owner signature
  const path = findItem(disclose(item));
  assert(items.checkRoot(merkleTreePathRoot<10, Field>(disclose(path))), "path must be valid");
}

export circuit publicKey(secret_key: Bytes<32>): Bytes<32> {
    return persistentHash<[Bytes<32>, Bytes<32>]>([pad(32, "trash"), secret_key]);
}

