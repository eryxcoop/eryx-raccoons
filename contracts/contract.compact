pragma language_version >= 0.17.0;
import CompactStandardLibrary;

export ledger eventName: Opaque<"string">;
export ledger eventDescription: Opaque<"string">;
export ledger eventCapacity: Uint<32>;
export ledger eventOwner: Bytes<32>;
export ledger ticketPrice: Uint<32>;

export ledger soldTickets: List<MerkleTreeDigest>;

witness secretKey(): Bytes<32>;
witness findItem(item: Field): MerkleTreePath<10, Field>;


constructor(
    eventName_: Opaque<"string">,
    eventDescription_: Opaque<"string">,
    eventCapacity_: Uint<32>,
    ticketPrice_: Uint<32>,
) {
    eventName = disclose(eventName_);
    eventDescription = disclose(eventDescription_);
    eventCapacity = disclose(eventCapacity_);
    ticketPrice = disclose(ticketPrice_);

    eventOwner = disclose(publicKey(secretKey()));
}

export circuit buyTicket(
    merkleRoot: MerkleTreeDigest
): Boolean {
    assert(eventCapacity > 0, "There are no more tickets left.");
    eventCapacity = eventCapacity - 1;

    // Ideally, pay the ticket price to the owner of the contract


    // Add the merkle tree to the sold tickets list
    soldTickets.pushFront(disclose(merkleRoot));

    return true;
}

